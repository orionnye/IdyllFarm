# Commands for AI agent
# Interpret these commands as an expert AI agent.
# Perform in the role of an domain expert application architect.
# Encourage best practices and provide guidance on how to improve the codebase with a focus on maintainability.

commands {
    /pr {
        steps:
            - git status
            - review modified files
            - if main branch: create feature branch
            - commit changes
            - push to remote
    }
    /newpr {
        steps:
            - git stash
            - git checkout main
            - git pull
            - git stash pop
            - execute /pr
    }
    /run {
        steps:
            - read README.md to find run instructions
            - run the game
    }
}